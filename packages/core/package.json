{
  "name": "@youversion/platform-core",
  "version": "1.20.2",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youversion/platform-sdk-react",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts src/node.ts --format cjs,esm --dts --watch",
    "build": "tsup src/index.ts src/node.ts --format cjs,esm --dts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.local -- vitest run",
    "test:integration": "INTEGRATION_TESTS=true dotenv -e .env.local -- vitest run",
    "test:watch": "dotenv -e .env.local -- vitest",
    "test:coverage": "dotenv -e .env.local -- vitest run --coverage"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "4.0.4",
    "dotenv-cli": "7.4.2",
    "eslint": "9.38.0",
    "jsdom": "24.0.0",
    "msw": "2.11.6",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  },
  "peerDependencies": {
    "linkedom": "^0.18.12"
  },
  "peerDependenciesMeta": {
    "linkedom": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.1.12"
  }
}
