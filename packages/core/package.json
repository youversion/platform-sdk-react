{
  "name": "@youversion/platform-core",
  "version": "2.12.0",
  "description": "A type-safe TypeScript SDK for accessing the YouVersion Platform APIs. Get Bible content and build Bible-based applications.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/*.css",
    "README.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/__tests__"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youversion/platform-sdk-react",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "jsdom": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./browser/styles/*": "./src/styles/*",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "pnpm build:js && pnpm build:types",
    "prepublishOnly": "YVP_PUBLISH_BUILD=true pnpm build && node ../../scripts/check-sdk-version-stamp.mjs core",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.local -- vitest run",
    "test:integration": "INTEGRATION_TESTS=true dotenv -e .env.local -- vitest run",
    "test:watch": "dotenv -e .env.local -- vitest",
    "test:coverage": "dotenv -e .env.local -- vitest run --coverage"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@types/jsdom": "^28.0.1",
    "@vitest/coverage-v8": "4.0.4",
    "dotenv-cli": "7.4.2",
    "jsdom": "28.1.0",
    "msw": "2.11.6",
    "tsup": "8.5.0",
    "typescript": "7.0.2",
    "vitest": "4.0.4"
  },
  "peerDependencies": {
    "jsdom": "^24.0.0 || ^28.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.1.12"
  }
}
