{
  "name": "@youversion/platform-react-ui",
  "version": "2.6.0",
  "description": "Pre-built React components for Bible applications with styling included.",
  "license": "Apache-2.0",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/tailwind.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "style": "./dist/tailwind.css",
  "types": "./dist/index.d.ts",
  "browser": {
    "jsdom": false
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles/global.css -o dist/tailwind.css --minify",
    "verify:styles": "node scripts/verify-styles.js",
    "generate:i18n": "node scripts/generate-i18n-resources.mjs",
    "build": "pnpm generate:i18n && pnpm build:css && pnpm build:js && pnpm verify:styles && pnpm build:types",
    "dev": "concurrently \"node scripts/generate-i18n-resources.mjs --watch\" \"tailwindcss -i src/styles/global.css -o dist/tailwind.css --watch\" \"NODE_ENV=development tsup --watch\"",
    "test": "pnpm generate:i18n && vitest run --project unit",
    "test:watch": "pnpm generate:i18n && vitest --project unit",
    "test:coverage": "pnpm generate:i18n && vitest run --project unit --coverage",
    "typecheck": "pnpm generate:i18n && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "YVP_PUBLISH_BUILD=true pnpm --filter @youversion/platform-core build && pnpm build && node ../../scripts/check-sdk-version-stamp.mjs ui",
    "storybook": "concurrently \"node scripts/generate-i18n-resources.mjs --watch\" \"tailwindcss -i src/styles/global.css -o dist/tailwind.css --watch\" \"storybook dev -p 6006\"",
    "build-storybook": "pnpm generate:i18n && storybook build",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@xstate/react": "^6.1.0",
    "@youversion/platform-core": "workspace:*",
    "@youversion/platform-react-hooks": "workspace:*",
    "better-result": "2.9.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "^26.0.0",
    "radix-ui": "^1.4.3",
    "react-i18next": "^17.0.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "xstate": "5.32.4"
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20.0.0",
    "react-dom": ">=19.1.0 <20.0.0"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-coverage": "^3.0.0",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-onboarding": "10.3.5",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@tailwindcss/cli": "4.1.15",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser-playwright": "4.0.4",
    "@vitest/coverage-v8": "4.0.4",
    "concurrently": "9.2.1",
    "dotenv-cli": "7.4.2",
    "eslint-plugin-storybook": "10.3.5",
    "jsdom": "27.0.1",
    "markdown-to-jsx": "^9.6.1",
    "msw": "2.13.4",
    "msw-storybook-addon": "2.0.7",
    "playwright": "1.56.1",
    "storybook": "10.3.5",
    "tailwindcss": "4.1.15",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vite": "7.1.11",
    "vitest": "4.0.4",
    "vitest-browser-react": "2.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youversion/platform-sdk-react",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "sdk",
    "youversion"
  ],
  "homepage": "https://github.com/youversion/platform-sdk-react#readme",
  "bugs": {
    "url": "https://github.com/youversion/platform-sdk-react/issues"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
