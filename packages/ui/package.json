{
  "name": "@youversion/platform-react-ui",
  "version": "0.10.1",
  "description": "React SDK for YouVersion Platform",
  "license": "TBD",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "style": "./dist/tailwind.css",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles/global.css -o dist/tailwind.css --minify && node scripts/strip-layers.js",
    "build": "pnpm build:css && pnpm build:js && pnpm build:types",
    "dev": "concurrently \"tailwindcss -i src/styles/global.css -o dist/tailwind.css --watch\" \"NODE_ENV=development tsup --watch\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm build",
    "storybook": "concurrently \"tailwindcss -i src/styles/global.css -o dist/tailwind.css --watch\" \"storybook dev -p 6006\"",
    "build-storybook": "storybook build",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@youversion/platform-core": "workspace:*",
    "@youversion/platform-react-hooks": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isomorphic-dompurify": "2.23.0",
    "lucide-react": "0.546.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20.0.0",
    "react-dom": ">=19.1.0 <20.0.0"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@storybook/addon-docs": "10.0.0",
    "@storybook/addon-onboarding": "10.0.0",
    "@storybook/addon-vitest": "10.0.0",
    "@storybook/react-vite": "10.0.0",
    "@tailwindcss/cli": "4.1.15",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser-playwright": "4.0.4",
    "@vitest/coverage-v8": "4.0.4",
    "concurrently": "9.2.1",
    "dotenv-cli": "7.4.2",
    "eslint-plugin-storybook": "10.0.0",
    "jsdom": "27.0.1",
    "msw": "2.11.6",
    "msw-storybook-addon": "2.0.6",
    "playwright": "1.56.1",
    "storybook": "10.0.0",
    "tailwindcss": "4.1.15",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vite": "7.1.11",
    "vitest": "4.0.4",
    "vitest-browser-react": "2.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youversion/platform-sdk-react",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "sdk",
    "youversion"
  ],
  "homepage": "https://github.com/youversion/platform-sdk-react#readme",
  "bugs": {
    "url": "https://github.com/youversion/platform-sdk-react/issues"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
