{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["react", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "dist",
    "skipLibCheck": true,
    "stripInternal": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "index.d.ts"],
  // src/test holds fixtures and harnesses that only the tests and the stories
  // import. It ships no public type. It is written against the browser lib from
  // the test tsconfig, and not against the narrower lib of this build.
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.ts", "**/*.stories.tsx", "src/test"]
}
