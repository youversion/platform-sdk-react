{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["react", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "dist",
    "skipLibCheck": true,
    "stripInternal": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "index.d.ts"],
  // src/test holds fixtures and harnesses that only tests and stories import.
  // It ships no public type, and it is written against the browser lib that the
  // test tsconfig provides rather than the narrower lib this build declares.
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.ts", "**/*.stories.tsx", "src/test"]
}
