{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["react", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "dist",
    "skipLibCheck": true,
    "stripInternal": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "index.d.ts"]
}
