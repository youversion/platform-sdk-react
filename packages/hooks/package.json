{
  "name": "@youversion/platform-react-hooks",
  "version": "2.12.0",
  "description": "React hooks for accessing YouVersion Platform APIs with automatic loading/error states.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/__tests__",
    "!dist/test",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.d.cts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youversion/platform-sdk-react",
    "directory": "packages/hooks"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "import": "./dist/test-utils.js",
      "require": "./dist/test-utils.cjs"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "rm -rf dist && pnpm build:js && pnpm build:types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@youversion/platform-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20.0.0"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "19.2.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "4.0.4",
    "jsdom": "27.0.1",
    "react-dom": "19.1.2",
    "tsup": "8.5.0",
    "typescript": "7.0.2",
    "vitest": "4.0.4"
  }
}
